{
  "name": "@uri/ai-utils",
  "version": "0.4.7",
  "minimumDependencyAge": 0,
  "license": "MIT",
  "exports": "./mod.ts",
  "exclude": ["npm", "site"],
  "publish": {
    "include": ["mod.ts", "src/**", "README.md", "deno.json"]
  },
  "imports": {
    "@anthropic-ai/sdk": "npm:@anthropic-ai/sdk@0.39.0",
    "@deno/dnt": "jsr:@deno/dnt@0.44.0",
    "@google/genai": "npm:@google/genai@2.10.0",
    "@std/assert": "jsr:@std/assert@1.0.14",
    "@std/cli": "jsr:@std/cli@^1.0.14",
    "@std/dotenv": "jsr:@std/dotenv@^0.225.6",
    "@std/encoding": "jsr:@std/encoding@^1.0.10",
    "@std/path": "jsr:@std/path@^1.0.8",
    "@uri/inject": "jsr:@uri/inject@0.0.2",
    "gamla": "jsr:@uri/gamla@0.0.16",
    "js-tiktoken": "npm:js-tiktoken@1.0.21",
    "openai": "npm:openai@5.2.0",
    "openai/resources/index.mjs": "npm:openai@5.2.0/resources/index.mjs",
    "rmmbr": "jsr:@uri/rmmbr@0.1.7",
    "zod": "npm:zod@3.25.57",
    "zod/v4": "npm:zod@3.25.57/v4"
  },
  "tasks": {
    "check": "deno fmt --check && deno lint && deno check *.ts src/**/*.ts tests/**/*.ts",
    "test": "deno test --allow-env --allow-net --allow-read --allow-write --env=.env tests/",
    "build-npm": "deno run -A scripts/build_npm.ts",
    "talk-to-bob": "deno run --allow-env --allow-run --allow-read --allow-write --allow-net --env=.env scripts/talk_to_bob.ts"
  },
  "githooks": {
    "$schema": "https://deno.land/x/githooks/schema.json",
    "pre-commit": "check"
  }
}
